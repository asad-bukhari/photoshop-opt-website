{
  "name": "optipack-portal",
  "private": true,
  "version": "3.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "NODE_OPTIONS=\"--dns-result-order=ipv4first --no-network-family-autoselection\" next build",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && NODE_OPTIONS=\"--dns-result-order=ipv4first --no-network-family-autoselection\" wrangler dev",
    "test": "vitest run",
    "deploy": "opennextjs-cloudflare build && NODE_OPTIONS=\"--dns-result-order=ipv4first --no-network-family-autoselection\" wrangler deploy",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "next": "^16.4.3",
    "pdf-lib": "^1.17.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.14",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.148.0"
  }
}
